{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/cadastro",
      "destination": "/cadastro.html"
    },
    {
      "source": "/meuPerfil",
      "destination": "/meuPerfil.html"
    },
    {
      "source": "/meuperfil",
      "destination": "/meuPerfil.html"
    }
  ]
}
